{
  "manifest_version": 2.0,
  "id": "enhancedproblems",
  "type": "widget",
  "name": "Enhanced Problems",
  "description": "Extends the standard Zabbix Problems widget with additional filtering and display options.",
  "namespace": "EnhancedProblems",
  "version": "7.0-1",
  "author": "initMAX s.r.o.",
  "url": "https://www.initmax.com",
  "widget": {
    "name": "Enhanced Problems",
    "size": {
      "width": 6,
      "height": 3
    },
    "refresh_rate": 60,
    "js_class": "CWidgetEnhancedProblems"
  },
  "actions": {
    "widget.enhancedproblems.view": {
      "class": "WidgetView"
    }
  },
  "assets": {
    "css": [
      "widget.css",
      "widget-edit.css",
      "fonts.css"
    ],
    "js": [
      "class.widget.js"
    ]
  }
}
